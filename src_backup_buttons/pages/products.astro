---
import BaseLayout from '../layouts/BaseLayout.astro';

const groups = [
  {
    name: 'Extra Success Chalk',
    items: ['White chalk', 'Coloured chalk (assorted colours)', 'Bulk cartons for schools & retailers'],
  },
  {
    name: 'Exercise Books',
    items: ['48 pages', '96 pages', '192 pages'],
  },
  {
    name: 'Counter Books',
    items: ['3 quire', '4 quire'],
  },
  {
    name: 'Other Stationery',
    items: ['Notepads', 'Artbooks', 'Graphbooks'],
  },
];
---
<BaseLayout title="Products">
  <section class="bg-brand-700 text-white">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h1 class="text-4xl font-extrabold">Our Products</h1>
      <p class="mt-3 max-w-2xl text-brand-100">Quality chalk and stationery for schools, offices and retailers. Bulk orders welcome.</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid gap-8 md:grid-cols-2">
      {groups.map(g => (
        <div class="rounded-xl border border-slate-200 bg-white p-6">
          <h2 class="text-xl font-bold text-brand-700">{g.name}</h2>
          <ul class="mt-4 space-y-2">
            {g.items.map(i => (
              <li class="flex items-start gap-2 text-slate-700">
                <span class="mt-1 text-brand-500">✓</span><span>{i}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="mt-12 rounded-xl bg-brand-50 p-8 text-center">
      <h2 class="text-2xl font-bold text-slate-900">Need a bulk quote?</h2>
      <a href="/contact" class="mt-4 inline-block rounded-lg bg-brand-600 px-6 py-3 font-semibold text-white transition hover:bg-brand-700">Request a Quote</a>
    </div>
  </section>
</BaseLayout>