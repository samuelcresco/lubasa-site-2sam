            <h2 class="text-yellow-400 font-bold text-lg leading-tight mb-2">{slide.rightTitle}</h2>
            <ul class="space-y-2 text-sm">
              {slide.rightList?.map(item => (
                <li class="flex items-start gap-2"><span class="text-yellow-400 font-bold mt-1">✓</span> <span set:html={item}></span></li>
              ))}
            </ul>
          </div>

          <!-- Buttons -->
          <div class="flex gap-2 mt-6">
            <a href="/order" class="flex-1 rounded bg-yellow-500 px-4 py-3 text-center text-sm font-bold text-black shadow-md transition hover:bg-yellow-400">PLACE ORDER</a>
            <a href="/LUBASA_CATALOGUE.pdf" download class="flex-1 rounded bg-white px-4 py-3 text-center text-sm font-bold text-brand-800 shadow-md transition hover:bg-gray-100">CATALOGUE</a>
