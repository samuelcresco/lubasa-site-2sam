---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="mx-auto max-w-3xl px-4 py-16">
    <a href="/blog" class="text-sm text-brand-600 hover:underline">← Back to Blog</a>
    <h1 class="mt-4 text-4xl font-extrabold text-slate-900">{post.data.title}</h1>
    <p class="mt-2 text-sm text-slate-500">{post.data.date.toDateString()} · {post.data.author}</p>
    <div class="prose prose-slate mt-8 max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>