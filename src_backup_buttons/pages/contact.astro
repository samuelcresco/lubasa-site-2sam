---
import BaseLayout from '../layouts/BaseLayout.astro';
import { company } from '../data/companyData';
---
<BaseLayout title="Contact">
  <section class="mx-auto max-w-4xl px-4 py-16">
    <h1 class="text-4xl font-extrabold text-slate-900">Contact Us</h1>
    <p class="mt-3 text-slate-600">Request a quote or ask about bulk supply. We'll get back to you.</p>

    <div class="mt-10 grid gap-8 md:grid-cols-2">
      
      <!-- Contact Form -->
      <form action="https://formspree.io/f/xgaawpgl" method="POST" class="space-y-4 bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
        <div>
          <label class="block text-sm font-medium text-slate-700" for="name">Name</label>
          <input id="name" name="name" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-brand-500 focus:outline-none" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700" for="email">Email</label>
          <input id="email" type="email" name="email" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-brand-500 focus:outline-none" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700" for="message">Message</label>
          <textarea id="message" name="message" rows="5" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-brand-500 focus:outline-none"></textarea>
        </div>
        <button type="submit" class="w-full rounded-lg bg-brand-600 px-6 py-3 font-semibold text-white transition hover:bg-brand-700">Send Message</button>
      </form>

      <!-- Contact Details (Dynamic) -->
      <div class="space-y-6">
        <div class="bg-brand-50 p-6 rounded-xl border border-brand-100">
          <h3 class="font-bold text-brand-900 text-lg mb-4">Get in Touch</h3>
          <ul class="space-y-4 text-slate-700">
            <li class="flex items-start gap-3">
              <span class="text-brand-600 text-xl">✉️</span>
              <div>
                <p class="font-semibold text-sm">Email</p>
                <a href={`mailto:${company.email}`} class="hover:text-brand-600">{company.email}</a>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-600 text-xl">📞</span>
              <div>
                <p class="font-semibold text-sm">Phone</p>
                <a href={`tel:${company.phone}`} class="hover:text-brand-600">{company.phone}</a>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-600 text-xl">📍</span>
              <div>
                <p class="font-semibold text-sm">Location</p>
                <p>{company.location}</p>
              </div>
            </li>
          </ul>
        </div>

        <div class="bg-slate-900 text-white p-6 rounded-xl shadow-md">
          <h3 class="font-bold text-brand-300 text-lg mb-2">Payment Details</h3>
          <p class="text-xs text-slate-400 mb-3">For bulk orders and deposits.</p>
          <div class="space-y-2 text-sm">
            <p><strong class="text-slate-300">Bank:</strong> {company.payment.bankName}</p>
            <p><strong class="text-slate-300">Acc No:</strong> {company.payment.accountNo}</p>
            <p><strong class="text-slate-300">MTN MoMo:</strong> {company.payment.mtnMomo}</p>
            <p><strong class="text-slate-300">Airtel Money:</strong> {company.payment.airtelMoney}</p>
          </div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>