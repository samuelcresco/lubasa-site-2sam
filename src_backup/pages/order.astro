---
import BaseLayout from '../layouts/BaseLayout.astro';
import { company } from '../data/companyData';

// Automatically group the products by category for the tabs
const categoriesMap = company.products.reduce((acc, product) => {
  if (!acc[product.category]) acc[product.category] = [];
  acc[product.category].push(product);
  return acc;
}, {} as Record<string, typeof company.products>);

const categories = Object.keys(categoriesMap).map(catName => ({
  id: catName.toLowerCase(),
  name: catName,
  items: categoriesMap[catName]
}));

// Flatten for the form dropdown
const allProducts = company.products.map(p => `${p.name} (${p.price}/=)`);
---
<BaseLayout title="Order & Pricing">
  <section class="bg-brand-700 text-white py-8">
    <div class="mx-auto max-w-6xl px-4 flex flex-col md:flex-row items-center justify-between gap-4">
      <div>
        <h1 class="text-3xl font-extrabold">Order & Pricing</h1>
        <p class="text-brand-100 mt-1">View prices and submit your order request.</p>
      </div>
      
      <!-- PAYMENT DETAILS BADGE (Now Dynamic) -->
      <div class="bg-brand-800 border border-brand-600 rounded-lg p-3 text-xs w-full md:w-auto shadow-lg">
        <p class="font-bold text-white mb-1">💳 Payment Details</p>
        <p class="text-brand-200">Bank: <span class="text-white">{company.payment.bankName}</span> | Acc: <span class="text-white">{company.payment.accountNo}</span></p>
        <p class="text-brand-200">MTN: <span class="text-white">{company.payment.mtnMomo}</span> | Airtel: <span class="text-white">{company.payment.airtelMoney}</span></p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-8 grid gap-8 md:grid-cols-2 items-start">
    
    <!-- LEFT SIDE: THE TABS -->
    <div class="bg-white rounded-2xl shadow-xl border border-slate-100 overflow-hidden">
      <div class="flex border-b border-slate-200 bg-slate-50 overflow-x-auto">
        {categories.map((cat, index) => (
          <button 
            class={`tab-btn flex-1 px-4 py-4 text-sm font-bold transition border-b-4 whitespace-nowrap ${index === 0 ? 'border-brand-600 text-brand-700 bg-white' : 'border-transparent text-slate-500 hover:bg-slate-100'}`}
            data-target={`tab-${cat.id}`}
          >
            {cat.name}
          </button>
        ))}
      </div>

      <div class="p-6">
        {categories.map((cat, index) => (
          <div id={`tab-${cat.id}`} class={`tab-content ${index === 0 ? 'block' : 'hidden'}`}>
            <ul class="space-y-3">
              {cat.items.map(item => (
                <li class="flex justify-between items-center p-3 rounded-lg hover:bg-brand-50 transition border border-transparent hover:border-brand-100">
                  <span class="font-medium text-slate-700">{item.name}</span>
                  <span class="font-bold text-brand-700 bg-brand-100/50 px-3 py-1 rounded-full">{item.price} /=</span>
                </li>
              ))}
            </ul>
            <div class="mt-6 p-4 bg-slate-50 rounded-lg border border-slate-200 text-xs text-slate-600">
              <strong>Delivery Note:</strong> Free delivery in Kampala/Wakiso for orders above UGX 500,000. Upcountry delivered via bus.
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- RIGHT SIDE: COMPACT ORDER FORM -->
    <div class="bg-white rounded-2xl shadow-xl border border-slate-100 p-6 sticky top-24">
      <h2 class="text-xl font-bold text-slate-900 mb-4">Submit Order Request</h2>
      
      <form action="https://formspree.io/f/xgaawpgl" method="POST" class="space-y-4">
        
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">School / Company</label>
            <input name="School_Name" required placeholder="e.g. Bright Future Academy" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Phone Number</label>
            <input name="Phone" required placeholder="e.g. 077..." class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">Product</label>
          <select name="Product" required class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none bg-white">
            <option value="">-- Choose item --</option>
            {allProducts.map(p => <option value={p}>{p}</option>)}
            <option value="Other">Other (Specify in notes)</option>
          </select>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Quantity</label>
            <input name="Quantity" type="number" min="1" required placeholder="e.g. 10" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Delivery Location</label>
            <input name="Location" required placeholder="e.g. Kampala" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">Notes / Other Items</label>
          <textarea name="Notes" rows="2" placeholder="Any special requests?" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none"></textarea>
        </div>

        <button type="submit" class="w-full rounded-lg bg-brand-600 px-6 py-3 font-bold text-white transition hover:bg-brand-700 shadow-lg shadow-brand-600/30">
          Send Order Request
        </button>
      </form>
    </div>

  </section>

  <script>
    const tabs = document.querySelectorAll('.tab-btn');
    const contents = document.querySelectorAll('.tab-content');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('border-brand-600', 'text-brand-700', 'bg-white');
          t.classList.add('border-transparent', 'text-slate-500');
        });
        contents.forEach(c => c.classList.add('hidden'));
        tab.classList.remove('border-transparent', 'text-slate-500');
        tab.classList.add('border-brand-600', 'text-brand-700', 'bg-white');
        const targetId = tab.getAttribute('data-target');
        document.getElementById(targetId)?.classList.remove('hidden');
      });
    });
  </script>
</BaseLayout>