    </div>

    <!-- LEFT SIDE BAR (Desktop Only) -->
    <div class="hidden md:flex md:w-[320px] bg-brand-900 p-6 md:p-8 flex-col justify-center border-r border-brand-700 z-20 relative order-1">
      <button id="prevBtn" class="hidden md:block absolute left-2 top-1/2 -translate-y-1/2 z-30 bg-brand-800 hover:bg-yellow-500 hover:text-black text-white p-2 rounded-full transition shadow-lg">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
      </button>
      <div class="relative h-[350px] mt-4 ml-10">
        {slides.map((slide, index) => (
          <div class={`slide-text-left ${index === 0 ? 'active' : ''} absolute top-0 left-0 w-full flex flex-col`}>
            <h1 class="text-2xl font-extrabold leading-tight text-white mb-4">
