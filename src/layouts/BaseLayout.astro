---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = "LUBASA Investments and Company Limited — manufacturers and suppliers of Extra Success Chalk (white & coloured), exercise books, counter books, notepads, artbooks and graphbooks." } = Astro.props;
const year = new Date().getFullYear();
const nav = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about' },
  { name: 'Products', href: '/products' },
  { name: 'Catalogue', href: '/catalogue' },
  { name: 'Blog', href: '/blog' },
  { name: 'Order', href: '/order' },
  { name: 'Contact', href: '/contact' },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | LUBASA Investments</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50">
    
    <!-- Top White Bar -->
    <div class="bg-white border-b border-slate-200 hidden md:block">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-2">
        <a href="/" class="flex items-center gap-3">
          <!-- YOUR LOGO HERE -->
          <img src="/images/logo.jpg" alt="LUBASA Logo" class="h-12 w-auto object-contain" />
          <span class="font-bold text-brand-700 text-xl tracking-tight">LUBASA INVESTMENTS</span>
        </a>
        <div class="flex items-center gap-4 text-xs font-medium text-slate-600">
          <a href="#" class="hover:text-brand-600">Sitemap</a>
          <span>|</span>
          <a href="/order" class="hover:text-brand-600">Place Order</a>
          <span>|</span>
          <a href="/contact" class="hover:text-brand-600">Contact Us</a>
        </div>
      </div>
    </div>

    <!-- Thick Blue Navigation Bar -->
    <header class="bg-brand-700 text-white shadow-md">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-1 md:py-0">
        <!-- Mobile Logo -->
        <a href="/" class="md:hidden flex items-center gap-2 py-2">
          <img src="/images/logo.jpg" alt="LUBASA Logo" class="h-8 w-auto bg-white rounded p-1" />
          <span class="font-bold text-sm">LUBASA</span>
        </a>
        
        <!-- Desktop Nav Links -->
        <ul class="hidden md:flex flex-1">
          {nav.map(item => (
            <li>
              <a href={item.href}
                 class:list={["block px-4 py-4 text-sm font-semibold transition border-b-4",
                   path === item.href 
                     ? "border-white bg-brand-800" 
                     : "border-transparent hover:bg-brand-600"]}>
                {item.name}
              </a>
            </li>
          ))}
        </ul>

        <!-- Mobile Menu Toggle -->
        <details class="md:hidden relative">
          <summary class="cursor-pointer list-none p-2">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
          </summary>
          <ul class="absolute right-0 top-10 z-50 w-48 space-y-1 rounded-md bg-white p-2 shadow-lg border border-slate-200 text-slate-700">
            {nav.map(item => (
              <li><a href={item.href} class="block rounded px-4 py-2 text-sm font-medium hover:bg-brand-50 hover:text-brand-700">{item.name}</a></li>
            ))}
          </ul>
        </details>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <!-- Professional Footer -->
    <footer class="mt-16 bg-slate-900 text-slate-300">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 md:grid-cols-4">
        <div class="md:col-span-2">
          <div class="flex items-center gap-3 mb-4">
            <img src="/images/logo.jpg" alt="LUBASA Logo" class="h-10 w-auto bg-white rounded p-1" />
            <p class="text-lg font-bold text-white">LUBASA INVESTMENTS</p>
          </div>
          <p class="text-sm max-w-sm">Manufacturers & suppliers of Extra Success Chalk and quality stationery for schools and offices in Uganda.</p>
        </div>
        <div>
          <p class="font-bold text-white uppercase tracking-wider text-sm mb-4">Quick Links</p>
          <ul class="space-y-2 text-sm">
            {nav.map(item => <li><a href={item.href} class="hover:text-white transition">{item.name}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="font-bold text-white uppercase tracking-wider text-sm mb-4">Contact Us</p>
          <ul class="space-y-2 text-sm">
            <li>Email: lubasainvestments@gmail.com</li>
            <li>Phone: +256 702944948</li>
            <li>Phone: +256 786610907</li>
            <li>Location: Makindye, Salaama Rd</li>
          </ul>
        </div>
      </div>
      <div class="border-t border-slate-800 py-6 text-center text-xs text-slate-500">
        © {year} LUBASA Investments and Company Limited. All rights reserved.
      </div>
    </footer>
  </body>
</html>