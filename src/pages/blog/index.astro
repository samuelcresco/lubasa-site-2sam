---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<BaseLayout title="Blog">
  <section class="mx-auto max-w-4xl px-4 py-16">
    <h1 class="text-4xl font-extrabold text-slate-900">Blog</h1>
    <p class="mt-3 text-slate-600">News, tips and updates from LUBASA Investments.</p>
    <ul class="mt-10 space-y-6">
      {posts.map(post => (
        <li class="rounded-xl border border-slate-200 p-6 transition hover:border-brand-300">
          <a href={`/blog/${post.id}`} class="text-xl font-semibold text-brand-700 hover:underline">{post.data.title}</a>
          <p class="mt-1 text-xs text-slate-500">{post.data.date.toDateString()} · {post.data.author}</p>
          <p class="mt-2 text-slate-600">{post.data.description}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>