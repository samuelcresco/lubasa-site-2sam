      </button>
      <div class="relative h-[350px] mt-4 mr-10">
        {slides.map((slide, index) => (
          <div class={`slide-text-right ${index === 0 ? 'active' : ''} absolute top-0 left-0 w-full flex flex-col`}>
            <h2 class="text-2xl font-extrabold leading-tight text-white mb-4">
              {slide.rightTitle}
            </h2>
            <ul class="space-y-3 text-blue-100 text-sm font-medium mb-6">
              {slide.rightList.map(item => (
                <li class="flex items-start gap-2"><span class="text-brand-400 font-bold mt-1">✓</span> <span set:html={item}></span></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

  </section>

  <!-- Quick Links Bar -->
  <div class="bg-brand-800 border-t border-brand-700 relative z-30 shadow-md">
    <div class="mx-auto max-w-6xl px-4 flex flex-wrap justify-center md:justify-start text-sm font-medium text-white">
