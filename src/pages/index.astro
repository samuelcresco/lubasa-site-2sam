---
<BaseLayout title="Home">
  
  <!-- MAIN SLIDER SECTION -->
  <section class="relative bg-black flex flex-col md:flex-row md:h-[600px]">
    
    <!-- CENTER (Image/Video) -->
    <!-- Changed h-[500px] to h-[350px] so it doesn't push the text off screen on phones -->
    <div class="w-full md:flex-1 relative h-[350px] md:h-full bg-black order-1 md:order-2 overflow-hidden">
      <div class="slider-container absolute inset-0 overflow-hidden">
        {slides.map((slide, index) => (
          <div class={`slide-item absolute inset-0 ${index === 0 ? 'active' : ''}`} data-type={slide.type}>
            {slide.type === 'video' ? (
              <video src={slide.src} preload="auto" muted playsinline class="main-media w-full h-full object-cover"></video>
            ) : (
              <img src={slide.src} alt="Slide" class="main-media w-full h-full object-cover" />
            )}
          </div>
        ))}
      </div>

      <!-- Mobile Arrows (Overlay on image) -->
      <button id="prevBtnMobile" class="absolute left-2 top-1/2 -translate-y-1/2 z-30 bg-black/60 hover:bg-yellow-500 hover:text-black text-white p-2 rounded-full transition shadow-lg md:hidden">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
      </button>
      <button id="nextBtnMobile" class="absolute right-2 top-1/2 -translate-y-1/2 z-30 bg-black/60 hover:bg-yellow-500 hover:text-black text-white p-2 rounded-full transition shadow-lg md:hidden">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
      </button>
    </div>

    <!-- MOBILE TEXT BLOCK (Moved OUTSIDE the image container so it sits below it) -->
    <div class="md:hidden bg-brand-800 w-full border-b border-brand-700">
      {slides.map((slide, index) => (
        <div class={`slide-text-mobile ${index === 0 ? 'active' : ''} md:hidden p-5 text-white`}>
          
          <!-- Left Text -->
          <div class="mb-4">
            <h2 class="text-yellow-400 font-bold text-lg leading-tight mb-2">{slide.leftTitle}</h2>
            <ul class="space-y-2 text-sm">
              {slide.leftList?.map(item => (
                <li class="flex items-start gap-2"><span class="text-yellow-400 font-bold mt-1">✓</span> <span set:html={item}></span></li>
              ))}
            </ul>
          </div>

          <!-- Right Text -->
